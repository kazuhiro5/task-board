rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // オーナー（bngutkr8）のUIDの場所だけ、本人がログインしている時に読み書きできる。
    // 他人がログインしても自分の場所すら作れない（無料枠を使われない）。設計書 5章・決定/0002。
    // UIDはパスワードではない（知られてもなりすましはできない）ので、公開リポジトリに書いてよい。
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && uid == 'jqNME9sRyUaYc71WrgnV0DtOMKb2';
    }
  }
}
