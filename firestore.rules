rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 自分のUIDの場所だけ読み書きできる。
    // オーナーの初回ログイン後、uid をオーナーのUID 1つに固定する（設計書 5章・決定/0002）。
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
